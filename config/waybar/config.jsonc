{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 14,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["hyprland/language", "custom/airplane", "custom/bluetooth", "custom/wifi", "backlight", "wireplumber", "battery"],

  "hyprland/workspaces": {
    "format": "{id}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  },

  "hyprland/language": {
    "format": "{short}"
  },

  "custom/airplane": {
    "exec": "rfkill list | grep -q 'Soft blocked: no' && echo '󰀝 ' || echo '󰀞 '",
    "interval": 2,
    "on-click": "rfkill list | grep -q 'Soft blocked: no' && rfkill block all || rfkill unblock all",
    "tooltip": true,
    "tooltip-format": "On/Off"
  },

  "custom/wifi": {
    "exec": "rfkill list wifi | grep -q 'Soft blocked: no' && echo '󰤨 ' || echo '󰤭 '",
    "interval": 2,
    "on-click": "rfkill toggle wifi",
    "tooltip": true,
    "tooltip-format": "On/Off"
  },

  "custom/bluetooth": {
    "exec": "rfkill list bluetooth | grep -q 'Soft blocked: no' && echo '󰂯 ' || echo '󰂲 '",
    "interval": 2,
    "on-click": "rfkill toggle bluetooth",
    "tooltip": true,
    "tooltip-format": "On/Off"
  },

  "backlight": {
    "format": "󰃟 {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "wireplumber": {
    "format": " {volume}%",
    "format-muted": " ",
    "tooltip-format": "Mute/Unmute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "battery": {
    "format": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%+",
    "on-click": "$HOME/.config/waybar/power-menu.sh"
  }
}

